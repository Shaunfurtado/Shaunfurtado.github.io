flowchart TB
    user["Authorized user<br/>and task scope"]
    grant["Session grant<br/>identity + expiry"]
    browser["Browser context<br/>scoped auth state"]
    controller["Exclusive controller<br/>current epoch"]
    observe["Versioned page<br/>observations"]
    handoff["Human takeover<br/>advance epoch"]
    user --> grant
    grant --> browser
    controller -->|"accepted commands"| browser
    browser --> observe
    user -->|"take control"| handoff
    handoff -->|"invalidate stale owner"| controller
