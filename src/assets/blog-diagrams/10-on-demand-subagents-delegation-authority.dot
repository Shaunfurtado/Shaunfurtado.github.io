digraph subagents {
rankdir=TB;
parent [label="parent run\ngeneration 0", class="key"];
spawn [label="subagent_run\nskill spawn spec\nresearch.deep"];
row [label="agent_subruns row\nlease · idempotency key"];
q [label="child queue\nreserved workers"];
child [label="child · generation 1\nenvelope, no transcript\ntools − parent-only"];
check [label="acceptance check\nschema + valid evidence"];
parent -> spawn;
spawn -> row;
row -> q;
q -> child;
child -> check [label="result"];
check -> parent [label="digest"];
parent -> row [label="cancel cascades", style=dashed];
}
