digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
parent [label="Parent task\ncurrent owner",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
contract [label="Child contract\nscope + evidence + budget"];
children [label="Bounded child tasks\nno authority expansion"];
results [label="Typed results\nevidence + limitations"];
review [label="Parent verifies\nand publishes"];
cancel [label="Cancellation\nowned descendants"];
parent -> contract [label="decompose"];
contract -> children [label="reserve budget"];
children -> results [label=""];
results -> review [label=""];
parent -> cancel [label=""];
cancel -> children [label="revoke current work",style=dashed,constraint=false];
{rank=same; parent; contract; children;}
{rank=same; cancel; results; review;}
}