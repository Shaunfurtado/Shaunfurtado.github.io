digraph caching {
rankdir=TB;
subgraph cluster_prefix {
  label="cacheable prefix";
  sys [label="frozen system prompt"];
  tools [label="tool list\nappend-only order"];
}
hist [label="history\nor stored summary"];
tail [label="trailing context\ntime · data · procedures"];
wire [label="wire layer\ncomponent hashes", class="key"];
prov [label="provider", class="ghost"];
usage [label="usage record\ncached · uncached\nunreported"];
sys -> tools -> hist -> tail -> wire;
wire -> prov;
prov -> usage;
}
