digraph caching {
rankdir=TB;
subgraph cluster_prefix {
  label="cacheable prefix";
  sys [label="frozen system prompt"];
  tools [label="tool list\nappend-only order"];
}
hist [label="history /\ncompaction summary"];
tail [label="trailing block\nclock · hooks · skills"];
wire [label="wire layer\ncomponent hashes\ncache key hint", class="key"];
prov [label="provider", class="ghost"];
usage [label="usage ledger\ncached · uncached · unreported"];
sys -> tools -> hist -> tail -> wire;
wire -> prov;
prov -> usage;
}
