flowchart TB
    question["What happens<br/>if this data is lost?"]
    cache["Disposable cache<br/>rebuild + stampede control"]
    notify["Pub/Sub notification<br/>loss-tolerant listener"]
    work["Work / stream state<br/>ack + duplicate tolerance"]
    lease["Ownership lease<br/>expiry + fencing"]
    policy["Match isolation, eviction,<br/>persistence, and recovery"]
    question -->|"recomputable"| cache
    question -->|"transient hint"| notify
    question -->|"unfinished obligation"| work
    question -->|"coordination"| lease
    cache --> policy
    notify --> policy
    work --> policy
    lease --> policy
