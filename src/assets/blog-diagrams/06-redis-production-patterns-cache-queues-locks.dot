digraph redis {
rankdir=TB;
feed [label="broker feeds\n+ pollers"];
cache [label="redis-cache\nLFU · no persistence\ninstrument search", class="ghost"];
subgraph cluster_durable {
  label="redis · noeviction · AOF";
  quote [label="quote key (30s)\nmonotonic Lua write"];
  ticks [label="live:ticks stream\nMAXLEN ~2000"];
  dirty [label="dirty set\nwrite-behind"];
}
evalr [label="alert evaluator\nsingle owner lease\nfenced checkpoint"];
flush [label="flusher\nbyte-compare ack"];
sql [label="SQL\nsnapshots · alerts", class="key"];
feed -> quote;
feed -> ticks;
quote -> dirty [style=dashed];
ticks -> evalr [label="XREAD"];
dirty -> flush;
flush -> sql;
evalr -> sql;
}
