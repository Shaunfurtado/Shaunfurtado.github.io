digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
question [label="What happens\nif this data is lost?",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
cache [label="Disposable cache\nrebuild + stampede control"];
notify [label="Pub/Sub notification\nloss-tolerant listener"];
work [label="Work / stream state\nack + duplicate tolerance"];
lease [label="Ownership lease\nexpiry + fencing"];
policy [label="Match isolation, eviction,\npersistence, and recovery"];
question -> cache [label="recomputable"];
question -> notify [label="transient hint"];
question -> work [label="unfinished obligation"];
question -> lease [label="coordination"];
cache -> policy [label=""];
notify -> policy [label=""];
work -> policy [label=""];
lease -> policy [label=""];
{rank=same; question;}
{rank=same; cache; notify; work; lease;}
{rank=same; policy;}
}