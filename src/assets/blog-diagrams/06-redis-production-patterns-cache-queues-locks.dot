digraph redis {
rankdir=TB;
feed [label="price feeds\n+ pollers"];
cache [label="cache instance\nallkeys-lfu · no AOF", class="ghost"];
subgraph cluster_durable {
  label="durable instance · noeviction · AOF";
  price [label="latest price\nmonotonic Lua write"];
  stream [label="tick stream\nMAXLEN ~N"];
  dirty [label="dirty set\nwrite-behind"];
}
cons [label="single consumer\nlease + fenced checkpoint"];
flush [label="flusher\nbyte-compare ack"];
sql [label="SQL\nsource of truth", class="key"];
feed -> price;
feed -> stream;
price -> dirty [style=dashed];
stream -> cons [label="XREAD"];
dirty -> flush;
flush -> sql;
cons -> sql;
}
