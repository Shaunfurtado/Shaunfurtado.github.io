digraph rq {
rankdir=TB;
api [label="API"];
sql [label="SQL run row\nintent + lane", class="key"];
q [label="RQ queues\nparent · child · workflow"];
w [label="SimpleWorker process\nheartbeats"];
run [label="run\nCAS claim, fenced"];
rec [label="reconciler"];
cron [label="scheduler\nlease + SQL CAS"];
api -> sql [label="1. commit"];
sql -> q [label="2. enqueue id"];
q -> w -> run;
run -> sql [label="result"];
sql -> rec [style=dashed];
rec -> q [label="re-enqueue", style=dashed];
cron -> sql [label="occurrence"];
}
