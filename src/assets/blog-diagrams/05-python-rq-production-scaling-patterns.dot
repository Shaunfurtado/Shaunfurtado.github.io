digraph rq {
rankdir=TB;
api [label="API admission"];
sql [label="SQL\nRunDispatchRecord\nlane = build hash", class="key"];
q [label="RQ lanes\nparent · workflow · child"];
w [label="SimpleWorker process\n2 heartbeats / 5s"];
run [label="agent run\nattempt + epoch fence"];
rec [label="reconciler\nevery 120s"];
cron [label="scheduler\nleader lease + SQL CAS"];
api -> sql [label="1. intent"];
sql -> q [label="2. enqueue run_id"];
q -> w;
w -> run;
run -> sql [label="events · result"];
rec -> q [label="re-enqueue / re-pin", style=dashed];
sql -> rec [style=dashed];
cron -> sql [label="occurrence row"];
}
