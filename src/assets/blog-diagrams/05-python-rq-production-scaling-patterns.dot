digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
intent [label="Durable task\n+ outbox intent",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
dispatch [label="Outbox dispatcher"];
queue [label="RQ queue\nsmall task identifier"];
worker [label="Worker\nclaim current attempt"];
result [label="Durable result\nversioned publication"];
reconcile [label="Reconciler\npending / stale work"];
intent -> dispatch [label="committed intent"];
dispatch -> queue [label="retryable enqueue"];
queue -> worker [label=""];
worker -> result [label="conditional commit"];
intent -> reconcile [label="durable source"];
reconcile -> queue [label="recovery",style=dashed,constraint=false];
{rank=same; intent; dispatch; queue;}
{rank=same; reconcile; result; worker;}
}