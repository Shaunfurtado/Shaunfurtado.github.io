digraph sandbox {
rankdir=TB;
agent [label="agent run"];
api [label="backend\nmints 120s grant\nwrites tool files", class="key"];
broker [label="sandbox broker\nverify · policy\nmemory admission"];
subgraph cluster_guest {
  label="guest · network none · cap_drop ALL";
  vm [label="BoxLite microVM\nor gVisor container"];
  ws [label="/workspace\ntools · runs · user/out"];
}
snap [label="snapshot tar\n(idle 90s)", class="ghost"];
out [label="downloads\npath + hash checked"];
agent -> api [label="sandbox_run_python"];
api -> broker [label="HMAC grant"];
api -> ws [label="materialize", style=dashed];
broker -> vm [label="exec, 30s"];
vm -> ws;
ws -> snap [style=dashed];
ws -> out;
}
