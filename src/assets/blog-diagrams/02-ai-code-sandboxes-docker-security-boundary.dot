digraph sandbox {
rankdir=TB;
agent [label="agent run"];
api [label="API\nshort-lived grant\nwrites tool files", class="key"];
broker [label="sandbox broker\nverify · policy\nmemory admission"];
subgraph cluster_guest {
  label="guest · no network · no caps";
  vm [label="microVM or\ngVisor container"];
  ws [label="workspace\ninputs · outputs"];
}
snap [label="idle snapshot", class="ghost"];
out [label="downloads\npath + hash checked"];
agent -> api [label="run code"];
api -> broker [label="signed grant"];
api -> ws [label="write inputs", style=dashed];
broker -> vm [label="exec + timeout"];
vm -> ws;
ws -> snap [style=dashed];
ws -> out;
}
