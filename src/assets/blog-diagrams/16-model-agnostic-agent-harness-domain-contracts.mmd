flowchart TB
    providers["Provider adapters<br/>capabilities + raw usage"]
    harness["Harness core<br/>identity + state + policy"]
    domain["Domain contracts<br/>units + rules + evidence"]
    tools["Authorized tools<br/>+ isolated execution"]
    artifacts["Verified artifacts<br/>+ explicit outcomes"]
    eval["Workflow-level evals<br/>approved support matrix"]
    providers -->|"normalized requests"| harness
    domain -->|"meaning + constraints"| harness
    harness -->|"approved actions"| tools
    tools -->|"results"| artifacts
    artifacts -->|"verify"| eval
    eval -.->|"supported profiles"| providers
