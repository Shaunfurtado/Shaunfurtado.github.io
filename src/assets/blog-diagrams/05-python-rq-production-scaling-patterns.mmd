flowchart TB
    intent["Durable task<br/>+ outbox intent"]
    dispatch["Outbox dispatcher"]
    queue["RQ queue<br/>small task identifier"]
    worker["Worker<br/>claim current attempt"]
    result["Durable result<br/>versioned publication"]
    reconcile["Reconciler<br/>pending / stale work"]
    intent -->|"committed intent"| dispatch
    dispatch -->|"retryable enqueue"| queue
    queue --> worker
    worker -->|"conditional commit"| result
    intent -->|"durable source"| reconcile
    reconcile -.->|"recovery"| queue
