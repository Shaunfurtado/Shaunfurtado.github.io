digraph harness {
rankdir=TB;
loop [label="agent loop\nAgents SDK"];
wrap [label="harness wrappers\npermissions · retries · scope"];
gate [label="dispatch gate\ncapabilities ∩ policy\nrefuse, never fall back", class="key"];
client [label="OpenAI-compatible\nclient"];
or [label="OpenRouter"];
an [label="Anthropic"];
self [label="self-hosted\nendpoint"];
dom [label="domain validators\nbindings · delivery gate"];
loop -> wrap -> gate -> client;
client -> or;
client -> an;
client -> self;
wrap -> dom [label="tool results", style=dashed];
}
