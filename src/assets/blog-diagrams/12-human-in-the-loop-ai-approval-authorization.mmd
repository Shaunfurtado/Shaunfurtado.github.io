flowchart TB
    proposal["Immutable proposal<br/>payload + resource version"]
    review["Human review<br/>consequence + evidence"]
    decision["Versioned decision<br/>approver + expiry"]
    dispatch["Dispatch revalidation<br/>claim logical action"]
    effect["External effect<br/>receipt / unknown outcome"]
    invalidate["Changed / expired:<br/>new proposal required"]
    proposal --> review
    review -->|"approve"| decision
    decision --> dispatch
    dispatch -->|"still valid"| effect
    dispatch -->|"not valid"| invalidate
    review -.->|"edit requested"| invalidate
