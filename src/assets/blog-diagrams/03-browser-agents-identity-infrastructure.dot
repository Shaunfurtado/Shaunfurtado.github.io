digraph browser {
rankdir=TB;
user [label="user"];
api [label="API\npermissions · version CAS\nviewer tokens", class="key"];
launcher [label="session launcher\nallowlist · DNS check\njournal · capacity"];
subgraph cluster_plane {
  label="internal network";
  session [label="browser container\nChromium · Playwright\nVNC"];
  proxy [label="egress proxy\nno private ranges"];
}
profile [label="profile volume\none writer"];
net [label="internet", class="ghost"];
user -> api;
api -> launcher [label="grant @ version"];
launcher -> session [label="start"];
session -> profile;
session -> proxy;
proxy -> net;
api -> session [label="viewer proxy", style=dashed];
}
