digraph browser {
rankdir=TB;
user [label="user"];
api [label="backend\nRBAC · epoch CAS\nviewer tokens", class="key"];
broker [label="browser broker\nallowlist · DNS check\njournal · capacity"];
subgraph cluster_plane {
  label="browser-plane (internal)";
  session [label="session container\nChromium · Playwright\nKasmVNC"];
  squid [label="squid egress\nno private ranges"];
}
profile [label="profile volume\none writer"];
net [label="internet", class="ghost"];
user -> api;
api -> broker [label="grant @ epoch"];
broker -> session [label="launch"];
session -> profile;
session -> squid;
squid -> net;
api -> session [label="WSS proxy (takeover)", style=dashed];
}
