digraph tools {
rankdir=TB;
all [label="all tools\n126 native + MCP\nconnectors · extensions", class="ghost"];
rbac [label="permission filter\nfresh, per run"];
inv [label="run inventory\nversioned hash", class="key"];
route [label="route profile\n9 routes + 10 core tools"];
model [label="model"];
guard [label="guard\nargs check → run → output check"];
tool [label="tool"];
all -> rbac -> inv -> route -> model;
model -> inv [label="capability_load (≤8)", style=dashed];
model -> guard [label="call"];
guard -> tool;
}
