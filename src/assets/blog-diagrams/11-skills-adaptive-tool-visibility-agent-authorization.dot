digraph tools {
rankdir=TB;
all [label="full catalogue\nnative · MCP · plugins", class="ghost"];
perm [label="permission filter\nfresh, per run"];
inv [label="run inventory\nversioned", class="key"];
route [label="route profile\n+ stable core tools"];
model [label="model"];
guard [label="guard\ncheck args → run\n→ check output"];
tool [label="tool"];
all -> perm -> inv -> route -> model;
model -> inv [label="load on demand", style=dashed];
model -> guard [label="call"];
guard -> tool;
}
