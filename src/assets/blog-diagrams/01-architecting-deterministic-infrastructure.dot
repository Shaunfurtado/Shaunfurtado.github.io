digraph topology {
rankdir=TB;
subgraph cluster_control {
  label="control network";
  api [label="API\nauth · permissions · SQL", class="key"];
  redis [label="Redis\nqueues · leases"];
  workers [label="workers\none owner per run"];
}
sbx [label="sandbox launcher\n(docker socket)"];
subgraph cluster_plane {
  label="browser network (internal)";
  brw [label="browser launcher\n(docker socket)"];
  session [label="browser session"];
  proxy [label="egress proxy"];
}
net [label="internet", class="ghost"];
api -> redis [label="enqueue id"];
redis -> workers;
workers -> redis [label="renew lease", style=dashed];
workers -> sbx [label="signed grant"];
workers -> brw [label="signed grant"];
brw -> session;
session -> proxy;
proxy -> net;
}
