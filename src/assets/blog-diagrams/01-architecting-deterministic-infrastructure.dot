digraph topology {
rankdir=TB;
subgraph cluster_control {
  label="control network";
  api [label="backend API\nauth · RBAC · SQL", class="key"];
  redis [label="Redis\nqueues · leases"];
  workers [label="RQ workers\none owner per run"];
}
sbx [label="sandbox broker\n(docker socket)"];
subgraph cluster_plane {
  label="browser-plane (internal: true)";
  brw [label="browser broker\n(docker socket)"];
  session [label="session container"];
  squid [label="squid egress"];
}
net [label="internet", class="ghost"];
api -> redis [label="enqueue run_id"];
redis -> workers;
workers -> redis [label="lease renew 5s", style=dashed];
workers -> sbx [label="HMAC grant"];
workers -> brw [label="grant"];
brw -> session;
session -> squid;
squid -> net;
}
