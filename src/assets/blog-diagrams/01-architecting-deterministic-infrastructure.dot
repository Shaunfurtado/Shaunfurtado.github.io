digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
intent [label="User intent",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
gate [label="Resolve authority\nand action version"];
owner [label="Claim execution\nwith owner generation"];
effect [label="Bounded external\naction"];
record [label="Durable action\nand outcome record"];
recover [label="Unknown outcome:\nreconcile, do not guess",fillcolor="#fbede1",color="#ba7245"];
intent -> gate [label=""];
gate -> owner [label="approved"];
owner -> effect [label=""];
gate -> record [label="proposal"];
effect -> record [label="receipt / uncertainty"];
record -> recover [label="ambiguous"];
recover -> owner [label="only if safe",style=dashed,constraint=false];
{rank=same; intent; gate; owner;}
{rank=same; effect; record; recover;}
}