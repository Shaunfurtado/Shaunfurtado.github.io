digraph artifacts {
rankdir=TB;
agent [label="agent\n(any model)"];
tool [label="apply-spec tool"];
val [label="strict validation\nclosed schema · allowlists", class="key"];
src [label="source check\nretrieved URLs · receipts"];
snap [label="versioned snapshot"];
ui [label="product components\nor fenced HTML iframe"];
agent -> tool -> val;
val -> agent [label="not applied + errors", style=dashed];
val -> src [label="valid"];
src -> snap -> ui;
}
