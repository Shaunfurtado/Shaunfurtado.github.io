digraph artifacts {
rankdir=TB;
agent [label="agent\n(any model)"];
tool [label="compose / patch /\npublish tool"];
val [label="validation\nextra=forbid · allowlists", class="key"];
src [label="source ledger\nretrieved URLs · receipts"];
snap [label="versioned snapshot"];
ui [label="our components\nor sandboxed kit iframe"];
agent -> tool -> val;
val -> agent [label="applied: false + errors", style=dashed];
val -> src [label="valid"];
src -> snap -> ui;
}
