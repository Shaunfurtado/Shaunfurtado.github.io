digraph compaction {
rankdir=TB;
turn [label="new turn"];
check [label="over threshold?", shape=diamond, style=""];
reuse [label="stored summary\n+ recent raw turns"];
summ [label="summariser\npolicy-approved model", class="key"];
fall [label="fallback\nold summary / drop oldest", class="ghost"];
input [label="model input"];
log [label="event log + search index\nnever compacted"];
turn -> check;
check -> reuse [label="no"];
check -> summ [label="yes"];
summ -> reuse [label="merged summary"];
summ -> fall [label="fails", style=dashed];
reuse -> input;
fall -> input;
input -> log [label="search / expand", style=dashed];
}
