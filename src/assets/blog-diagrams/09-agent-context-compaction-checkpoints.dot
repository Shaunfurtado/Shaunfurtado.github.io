digraph compaction {
rankdir=TB;
turn [label="new turn"];
check [label="over 80% of\nbudget − reserve?", shape=diamond, style=""];
reuse [label="frozen summary\n+ recent raw turns"];
summ [label="cheap summariser\npolicy-approved model", class="key"];
fall [label="fallback\nfrozen summary / drop oldest", class="ghost"];
input [label="model input"];
index [label="audit log + FTS index\nnever compacted"];
turn -> check;
check -> reuse [label="no"];
check -> summ [label="yes"];
summ -> reuse [label="new summary"];
summ -> fall [label="fails", style=dashed];
reuse -> input;
fall -> input;
input -> index [label="session_search / expand", style=dashed];
}
