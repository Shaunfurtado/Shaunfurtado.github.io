digraph scaling {
rankdir=TB;
queues [label="RQ queues\nparent · child · other"];
pool [label="pool parent\ndepth − ready − starting\ncgroup CPU / memory", class="key"];
kids [label="worker processes\npreload, then register"];
ctl [label="host controller\nfresh heartbeats\navailable memory"];
lock [label="deploy lock", class="ghost"];
brw [label="browser service\nown admission"];
sbx [label="sandbox service\nown admission"];
queues -> pool [label="depth + readiness"];
pool -> kids [label="spawn"];
pool -> kids [label="SIGTERM once", style=dashed];
ctl -> pool [label="scale containers"];
lock -> ctl [style=dashed];
ctl -> brw [label="same host RAM", style=dashed, dir=none];
ctl -> sbx [style=dashed, dir=none];
}
