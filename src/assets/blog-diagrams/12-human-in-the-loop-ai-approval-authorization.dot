digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
proposal [label="Immutable proposal\npayload + resource version",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
review [label="Human review\nconsequence + evidence"];
decision [label="Versioned decision\napprover + expiry"];
dispatch [label="Dispatch revalidation\nclaim logical action"];
effect [label="External effect\nreceipt / unknown outcome"];
invalidate [label="Changed / expired:\nnew proposal required",fillcolor="#fbede1",color="#ba7245"];
proposal -> review [label=""];
review -> decision [label="approve"];
decision -> dispatch [label=""];
dispatch -> effect [label="still valid"];
dispatch -> invalidate [label="not valid"];
review -> invalidate [label="edit requested",style=dashed,constraint=false];
{rank=same; proposal; review; decision;}
{rank=same; invalidate; effect; dispatch;}
}