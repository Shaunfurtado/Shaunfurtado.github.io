digraph islands {
rankdir=TB;
answer [label="model answer\nwith closed tokens"];
md [label="token → relative link\nsurvives sanitiser"];
island [label="price components ×N"];
prov [label="one provider\nper conversation\ndeduped demand", class="key"];
ws [label="WebSocket\nsnapshot, then ticks"];
feed [label="price streams", class="ghost"];
frame [label="sandboxed canvas\nvia postMessage"];
answer -> md -> island -> prov;
prov -> ws [label="subscribe"];
feed -> ws;
prov -> frame [label="forward ticks", style=dashed];
}
