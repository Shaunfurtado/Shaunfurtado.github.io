digraph islands {
rankdir=TB;
answer [label="agent answer\n{{ltp:NSE:SYM|…}}"];
md [label="token → relative link\nsurvives sanitiser"];
island [label="LiveLtpIsland ×N"];
prov [label="one provider per chat\ndeduped demand", class="key"];
ws [label="WebSocket\nsnapshot, then ticks"];
redis [label="Redis price streams", class="ghost"];
frame [label="canvas iframe\npostMessage"];
answer -> md -> island -> prov;
prov -> ws [label="subscribe ≤5s"];
redis -> ws;
prov -> frame [label="aw-ltp", style=dashed];
}
