digraph design {
graph [rankdir=TB, bgcolor="#f6f4ee", pad="0.32", nodesep="0.42", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#b9c8c4", penwidth=1.3, fontname="DejaVu Sans", fontsize=17, margin="0.20,0.16"];
edge [color="#58736e", fontname="DejaVu Sans", fontsize=12, arrowsize=0.7, penwidth=1.4];
log [label="Durable event\nand evidence record",fillcolor="#16352f",fontcolor="#ffffff",color="#16352f"];
audit [label="Audit projection\npermitted full history"];
ui [label="UI projection\nprogress + artifacts"];
model [label="Model projection\nselected working state"];
rules [label="Authoritative constraints\n+ current task state"];
budget [label="Bounded request\noutput / tool reserves"];
log -> audit [label=""];
log -> ui [label=""];
log -> model [label="selection"];
rules -> model [label="must retain"];
model -> budget [label="provider-valid format"];
{rank=same; log; rules;}
{rank=same; audit; ui; model;}
{rank=same; budget;}
}