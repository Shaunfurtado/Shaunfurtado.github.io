digraph context {
rankdir=TB;
log [label="event log\nfull + public payloads", class="key"];
ui [label="UI stream\nvisibility filter"];
subgraph cluster_input {
  label="model input, in order";
  prefix [label="1. cached prefix\nsystem + tools", class="ghost"];
  summary [label="2. summary (optional)"];
  proj [label="3. prior turns\nper-tool caps"];
  tail [label="4. trailing block\nhooks · procedures · status"];
}
log -> ui;
log -> proj [label="projectors"];
prefix -> summary -> proj -> tail [style=dashed];
}
